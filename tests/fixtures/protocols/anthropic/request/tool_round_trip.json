{
  "model": "claude-test",
  "max_tokens": 256,
  "system": [
    {
      "type": "text",
      "text": "Keep boundaries.",
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ],
  "messages": [
    {
      "role": "assistant",
      "content": [
        {
          "type": "text",
          "text": "Using a tool."
        },
        {
          "type": "tool_use",
          "id": "toolu_fixture",
          "name": "read_file",
          "input": {
            "path": "README.md"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "toolu_fixture",
          "content": [
            {
              "type": "text",
              "text": "fixture output"
            }
          ],
          "is_error": false
        },
        {
          "type": "text",
          "text": "Continue."
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "read_file",
      "description": "Read one safe fixture.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ],
  "stream": true,
  "metadata": {
    "user_id": "fixture-user"
  }
}
